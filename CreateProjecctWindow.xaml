<Window x:Class="TestWindow.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestWindow"
        Title="Crear Proyecto" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="#1e1e1e">
    
    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="White" BorderThickness="0.5">
            <!-- Formulario -->
            <StackPanel Grid.Column="0" Margin="10 0 20 0">
                <TextBlock Text="Crear un Datapack" Foreground="White" FontSize="15"
                           FontWeight="Bold" Margin="0 5 0 0"/>

                <!-- Nombre del Datapack -->
                <TextBlock Text="Nombre del Datapack" Foreground="White" Margin="0 10 0 0"/>
                <TextBox x:Name="ProjectNameBox" Background="#333" Foreground="White" Width="200" HorizontalAlignment="Left"/>

                <!-- Namespace del Datapack -->
                <TextBlock Text="Namespace" Foreground="White" Margin="0 10 0 0"/>
                <TextBox x:Name="ProjectNamespaceBox" Background="#333" Foreground="White" Width="120" HorizontalAlignment="Left"/>

                <!-- Descripcion del Datapack -->
                <TextBlock Text="Descripción" Foreground="White" Margin="0 10 0 0"/>
                <TextBox x:Name="ProjectDescriptionBox" Background="#333" 
                     Foreground="White" Width="280" HorizontalAlignment="Left"
                     Height="60" TextWrapping="Wrap" TextChanged="UpdatePreview"/>

                <!-- Version del Datapack -->
                <TextBlock Text="Version" Foreground="White" Margin="0 10 0 0"/>
                <ComboBox IsReadOnly="True" IsEditable="True" Text="Seleccionar Version..."
                      x:Name="VersionSelector" Foreground="#333" Width="175"
                      HorizontalAlignment="Left" SelectionChanged="UpdatePreview">
                    <ComboBoxItem Content="Seleccionar Version..." Tag="None"/>
                    <ComboBoxItem Content="v81 (1.21.7 - 1.21.8)" Tag="81"/>
                    <ComboBoxItem Content="v80 (1.21.6)" Tag="80"/>
                    <ComboBoxItem Content="v71 (1.21.5)" Tag="71"/>
                    <ComboBoxItem Content="v61 (1.21.4)" Tag="61"/>
                    <ComboBoxItem Content="v57 (1.21.2 - 1.21.3)" Tag="57"/>
                    <ComboBoxItem Content="v48 (1.21 - 1.21.1)" Tag="48"/>
                    <ComboBoxItem Content="v41 (1.20.5 - 1.20.6)" Tag="41"/>
                    <ComboBoxItem Content="v26 (1.20.3 - 1.20.4)" Tag="26"/>
                    <ComboBoxItem Content="v18 (1.20.2)" Tag="18"/>
                    <ComboBoxItem Content="v15 (1.20 - 1.20.1)" Tag="15"/>
                    <ComboBoxItem Content="v12 (1.19.4)" Tag="12"/>
                    <ComboBoxItem Content="v10 (1.19 - 1.19.3)" Tag="10"/>
                </ComboBox>

                <!-- Ruta del Proyecto -->
                <TextBlock Text="Ruta del Proyecto" Foreground="White" Margin="0 10 0 0"/>
                <TextBox x:Name="PathBox" Background="#333" Foreground="White"
                     Width="300" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Margin="0 7 0 0">
                    <Button Content="Seleccionar Carpeta." Width="150" Click="SelectPath"/>
                    <Button Content="Ruta Predeterminada" Width="150" Click="DefaultPath"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Preview -->
        <StackPanel Grid.Column="1" Background="#1a1a1a" Margin="10 0 0 0">
            <TextBlock Text="Vista previa (pack.mcmeta)" Foreground="LightGray"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap"
                     Background="#2e2e2e" Foreground="LightGreen" FontFamily="Consolas" Height="340"/>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0 20 0 0">
            <Button Content="Cancelar" Width="100" Click="CancelProject" Margin="0 0 10 0"/>
            <Button Content="Crear Proyecto" Width="120"
                    Click="CreateProject"/>
        </StackPanel>
        
    </Grid>
</Window>
